# Required: OpenRouter key used by the /api/chat proxy (never shipped to the browser).
OPEN_ROUTER_SECRET=sk-or-v1-...

# Comma-separated failover chain. These free models need 0 credits, but without
# credits the account is capped at 50 free requests/day.
OPEN_ROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,cohere/north-mini-code:free,nvidia/nemotron-3.5-lightning:free

# Optional: separate reviewer chain for the ETHSKILLS audit.
OPEN_ROUTER_AUDIT_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,cohere/north-mini-code:free,nvidia/nemotron-3.5-lightning:free

# Optional: extra origins allowed to call /api/chat (comma-separated).
# Same-origin requests are always allowed.
ALLOWED_ORIGINS=

# Vault deployment (TelosVault is deployed directly, no factory).
# Stargate V2 native ETH pool per chain (TelosVault reverts if the pool is ERC20).
VITE_STARGATE_ETH_BASE_SEPOLIA=
VITE_STARGATE_ETH_ARB_SEPOLIA=
# Backend-controlled operator address that can bridge and update deployed value.
VITE_TELOS_AGENT_ADDRESS=
# Receives the protocol fee share (2% of withdrawals).
VITE_PROTOCOL_TREASURY=
# Telos API base URL. Empty uses the same origin (dev proxy / production).
VITE_TELOS_API_BASE=
